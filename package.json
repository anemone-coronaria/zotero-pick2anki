{
  "name": "zotero-pick2anki",
  "type": "module",
  "version": "1.0.7",
  "description": "A Zotero dictionary plugin that looks up selected English words and saves contextual vocabulary cards to Anki.",
  "config": {
    "addonName": "Pick2anki",
    "addonID": "zoteropick2anki@soyami.github.io",
    "addonRef": "zoteropick2anki",
    "addonInstance": "ZoteroPick2anki",
    "prefsPrefix": "extensions.zotero.zoteropick2anki"
  },
  "homepage": "https://github.com/anemone-coronaria/zotero-pick2anki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anemone-coronaria/zotero-pick2anki.git"
  },
  "author": "soyami",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "start": "zotero-plugin serve",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:i18n": "node scripts/run-i18n-tests.mjs"
  },
  "keywords": [
    "zotero",
    "anki",
    "dictionary",
    "vocabulary"
  ],
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "0.9.2"
  }
}
